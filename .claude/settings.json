{
  "permissions": {
    "allow": [
      "Bash(yarn test:run:*)",
      "Bash(yarn typecheck)",
      "Bash(yarn build)",
      "Bash(yarn format:*)",
      "Bash(./scripts/nlm list:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prettier-format.js"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typescript-check.js"
          }
        ]
      }
    ]
  }
}
