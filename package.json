{
  "name": "automated-notebooklm",
  "version": "1.0.0",
  "description": "Turn Monday.com-curated articles into NotebookLM podcasts and publish them to RedCircle",
  "scripts": {
    "generate-podcasts": "NODE_TLS_REJECT_UNAUTHORIZED=0 ts-node src/scripts/generatePodcastForUrl.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "notebooklm",
    "podcast",
    "monday.com",
    "redcircle",
    "automation"
  ],
  "author": "Omri Lavi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omril321/automated-notebooklm.git"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@mondaydotcomorg/api": "^11.0.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.1",
    "playwright": "^1.39.0",
    "ts-node": "^10.9.1",
    "user-agents": "^1.1.609"
  },
  "devDependencies": {
    "@types/node": "^20.8.3",
    "@types/user-agents": "^1.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "prettier": "^3.6.2",
    "typescript": "^5.2.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.4"
  }
}
