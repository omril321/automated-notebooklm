# Monday.com board to read candidates from and write results to (required)
MONDAY_API_TOKEN=your_monday_api_token
MONDAY_BOARD_URL=https://your_slug.monday.com/boards/1234567890
# Comma-separated group IDs (not titles) to skip, e.g. your "Done" group
MONDAY_EXCLUDED_GROUP_IDS=group_id_1,group_id_2

# RedCircle upload, runs after every successful generation (required)
RED_CIRCLE_USER=some_user@gmail.com
RED_CIRCLE_PASSWORD=your_redcircle_password
# Must match the podcast image alt text on RedCircle
PUBLISHED_PODCAST_NAME="My Podcast Name"
